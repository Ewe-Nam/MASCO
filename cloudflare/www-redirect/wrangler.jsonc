// Redirects www.mamfeapostolicschoolcomplex.com -> the bare domain.
// Deploy from this folder: npx wrangler deploy
{
  "name": "masco-www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "routes": [
    { "pattern": "www.mamfeapostolicschoolcomplex.com", "custom_domain": true }
  ]
}
